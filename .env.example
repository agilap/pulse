# Pulse local development configuration
# Copy to .env and adjust as needed. No secrets committed.

# PostgreSQL (used by docker-compose)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=changeme-not-a-real-secret
POSTGRES_DB=pulse

# Application database connection
DATABASE_URL=postgresql://pulse:changeme-not-a-real-secret@localhost:5432/pulse

# Monitor interval bounds (seconds): 60 to 86400 (1 min to 24 hours)
MIN_INTERVAL_SECONDS=60
MAX_INTERVAL_SECONDS=86400
DEFAULT_INTERVAL_SECONDS=60

# Worker / check settings
REQUEST_TIMEOUT_SECONDS=10
LEASE_DURATION_SECONDS=30
WORKER_CONCURRENCY=5
WEBHOOK_CONCURRENCY=10
WEBHOOK_MAX_ATTEMPTS=8
MONITOR_CAP=50

# Retention
RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90

# API server
API_HOST=127.0.0.1
API_PORT=8000
